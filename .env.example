# ==========================================
# EvoAgent Environment Configuration Template
# ==========================================

# Model Provider: heuristic | openai_compatible | ollama | mock
EVOAGENT_MODEL_PROVIDER=heuristic
EVOAGENT_MODEL_NAME=qwen2.5-coder:1.5b
EVOAGENT_API_BASE_URL=http://localhost:11434/v1
EVOAGENT_API_KEY=not-needed-for-local
# Seconds to wait for one model response (raise for CPU-only inference)
EVOAGENT_REQUEST_TIMEOUT_SECONDS=120

# Execution & Sandbox Limits
# local: host subprocess; docker: container with no network (build docker/sandbox.Dockerfile first)
EVOAGENT_SANDBOX_BACKEND=local
EVOAGENT_SANDBOX_IMAGE=evoagent-sandbox:latest
EVOAGENT_TIMEOUT_SECONDS=60
EVOAGENT_MAX_REPAIR_ATTEMPTS=3
EVOAGENT_MAX_TOOL_CALLS=10
EVOAGENT_MAX_PATCH_LINES=100

# Memory & Persistence
# Set to 'sqlite' (local file) or 'postgres'
EVOAGENT_MEMORY_BACKEND=sqlite
EVOAGENT_MEMORY_DB_PATH=./data/evoagent_memory.db
# EVOAGENT_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/evoagent

# pgvector embeddings (EVOAGENT_MEMORY_BACKEND=postgres)
# hashing needs no model; openai_compatible calls /embeddings (e.g. Ollama nomic-embed-text, dim 768)
EVOAGENT_EMBEDDING_PROVIDER=hashing
EVOAGENT_EMBEDDING_DIM=384
# EVOAGENT_EMBEDDING_MODEL=nomic-embed-text

# API & remote workers (Milestone 5)
# memory/memory: single process (evoagent serve --embedded-worker); postgres/redis: remote workers
EVOAGENT_JOB_STORE_BACKEND=memory
EVOAGENT_QUEUE_BACKEND=memory
EVOAGENT_REDIS_URL=redis://localhost:6379/0
# Comma-separated bearer tokens; generate with: openssl rand -hex 24
EVOAGENT_API_TOKENS=
# A worker that sends no heartbeat for this long loses its job to another worker
EVOAGENT_QUEUE_VISIBILITY_TIMEOUT_SECONDS=300
EVOAGENT_QUEUE_MAX_DELIVERIES=3
EVOAGENT_MAX_UPLOAD_BYTES=2000000
# Uploaded repositories only run in the docker sandbox unless this is true (trusted callers only)
EVOAGENT_WORKER_ALLOW_LOCAL_SANDBOX=false
EVOAGENT_WORKER_BENCHMARK_ROOTS=benchmarks

# Logging & Observability
EVOAGENT_LOG_LEVEL=INFO
EVOAGENT_TRACE_DIR=./logs/traces
